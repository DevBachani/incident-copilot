# Copy this file to `.env` and fill in your keys.  NEVER commit `.env`.
#
#   cp .env.example .env     (Git Bash)   or   copy .env.example .env   (PowerShell)

# --- LLM free-tier keys ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Optional: override model ids if a provider renames a model (they drift often) ---
# GROQ_MODEL=groq/openai/gpt-oss-20b
# GEMINI_MODEL=gemini/gemini-3.8-flash
# OPENROUTER_MODEL=openrouter/nvidia/nemotron-3.5-lightning:free

# --- Langfuse (used from Phase 9; leave blank for now) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Data stores (used from Phase 1+; defaults are fine for now) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_copilot
REDIS_URL=redis://localhost:6379/0
